# Copiá este archivo a .env.local y completá los valores.
# NUNCA commitees un .env real (el .gitignore los excluye, salvo este ejemplo).
# Con Supabase local, `npx supabase status` muestra la URL y las claves.

# --- Supabase (públicas: pueden llegar al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRETA: solo servidor, nunca con prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (solo Supabase LOCAL: lo lee supabase/config.toml vía env(...);
# en producción se cargan en el dashboard de Supabase, no en Vercel) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Web Push (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRETA: solo servidor
VAPID_PRIVATE_KEY=
# Contacto requerido por el protocolo Web Push (mailto: o https:)
VAPID_SUBJECT=mailto:admin@example.com

# --- Cron (SECRETA) ---
# Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- App ---
# URL pública de la app (sin barra final). En Vercel: https://<dominio>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
